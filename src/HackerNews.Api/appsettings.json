{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    },
    "Console": {
      "FormatterName": "json"
    }
  },
  "AllowedHosts": "*",
  "HackerNews": {
    "BaseAddress": "https://hacker-news.firebaseio.com/v0/",
    "BestStoriesTtl": "00:01:00",
    "ItemTtl": "00:05:00",
    "StaleTtl": "1.00:00:00",
    "RefreshEnabled": true,
    "RefreshInterval": "00:00:45",
    "ItemRefreshInterval": "00:04:00",
    "AttemptTimeout": "00:00:05",
    "TotalRequestTimeout": "00:00:20",
    "MaxRetryAttempts": 3,
    "RetryBaseDelay": "00:00:00.500"
  },
  "BestStories": {
    "MaxCount": 200,
    "MaxConcurrency": 8
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "Window": "00:01:00",
    "QueueLimit": 0
  },
  "ResponseCaching": {
    "Duration": "00:00:30"
  }
}
